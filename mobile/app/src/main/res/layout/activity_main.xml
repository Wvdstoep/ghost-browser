<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Top bar -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bar"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            app:icon="@android:drawable/ic_menu_revert" app:iconTint="@color/muted" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/urlLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            app:boxBackgroundColor="@color/panel" app:hintEnabled="false"
            app:boxStrokeColor="@color/line" app:boxCornerRadiusTopStart="10dp"
            app:boxCornerRadiusTopEnd="10dp" app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/url"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textUri" android:imeOptions="actionGo" android:maxLines="1"
                android:hint="Search or enter URL" android:textColor="@color/text"
                android:textColorHint="@color/muted" android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/go"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="4dp" android:minWidth="0dp" android:text="Go" android:insetTop="0dp" android:insetBottom="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tools"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            app:icon="@android:drawable/ic_menu_manage" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/webHolder"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <!-- Tools sheet (Agent / Profiles / Cluster) -->
    <LinearLayout
        android:id="@+id/panel"
        android:orientation="vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:visibility="gone" android:background="@color/panel"
        android:elevation="12dp">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:tabMode="fixed" app:tabTextColor="@color/muted" app:tabSelectedTextColor="@color/accent"
            app:tabIndicatorColor="@color/accent" android:background="@color/panel">
            <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Agent" />
            <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Profiles" />
            <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cluster" />
        </com.google.android.material.tabs.TabLayout>

        <ScrollView
            android:id="@+id/toolsScroll"
            android:layout_width="match_parent" android:layout_height="380dp"
            android:fillViewport="true">
        <ViewFlipper
            android:id="@+id/flipper"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="14dp">

            <!-- 0: Agent -->
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="On-device model (offline — no key, no cluster)" android:textColor="@color/accent" android:textStyle="bold" android:paddingBottom="6dp" />
                <Spinner android:id="@+id/modelSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:id="@+id/modelNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="@color/muted" android:textSize="11sp" android:paddingTop="2dp" android:paddingBottom="6dp" />
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Custom .task URL (for the Custom option)">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/customUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textUri" android:maxLines="1" android:textColor="@color/text" android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:hint="Access token (only if the model is gated)" app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/hfToken" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:maxLines="1" android:textColor="@color/text" android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical">
                    <com.google.android.material.button.MaterialButton android:id="@+id/downloadModel" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Download / Use" />
                    <TextView android:id="@+id/modelStatus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="not downloaded" android:textColor="@color/muted" android:textSize="12sp" />
                </LinearLayout>
                <ProgressBar android:id="@+id/modelProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="0" android:visibility="gone" />
                <CheckBox android:id="@+id/useLocal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Use on-device model (instead of Ollama)" android:textColor="@color/text" android:buttonTint="@color/accent" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" android:layout_marginTop="10dp" android:layout_marginBottom="12dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="…or your Ollama key" android:textColor="@color/muted" android:textSize="12sp" android:paddingBottom="8dp" />
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Ollama endpoint (https://host/v1)">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/endpoint" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textUri" android:maxLines="1" android:textColor="@color/text" android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="API key" app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/apiKey" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:maxLines="1" android:textColor="@color/text" android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Model (e.g. glm-4)">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/model" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="@color/text" android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Task — what should GB do?">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/task" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/run" style="@style/Widget.Material3.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Run" app:icon="@android:drawable/ic_media_play" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/stop" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Stop" />
                </LinearLayout>
            </LinearLayout>

            <!-- 1: Profiles -->
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Your platforms" android:textColor="@color/accent" android:textStyle="bold" android:paddingBottom="2dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="This phone is its own browser. Tap a platform to open it and sign in once here — the session then lives in its own isolated profile on the device (real residential IP, passes bot walls)." android:textColor="@color/muted" android:textSize="11sp" android:paddingBottom="8dp" />
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <com.google.android.material.button.MaterialButton android:id="@+id/loadPlatforms" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Load from cluster" />
                    <TextView android:id="@+id/platformsHint" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Sign in on the Cluster tab first" android:textColor="@color/muted" android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/platformCards" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Manual profiles — each keeps its own isolated cookies / logins" android:textColor="@color/muted" android:textSize="12sp" android:paddingBottom="8dp" />
                <TextView android:id="@+id/currentProfileLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Active: default" android:textColor="@color/accent" android:textSize="13sp" android:textStyle="bold" android:paddingBottom="8dp" />
                <com.google.android.material.chip.ChipGroup android:id="@+id/profileChips" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" />
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical">
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="New profile name">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/newProfile" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="@color/text" android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/addProfile" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Add" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="Switching a profile reloads the browser with that profile's own cookie jar — like the cluster's isolated identities." android:textColor="@color/muted" android:textSize="11sp" />
            </LinearLayout>

            <!-- 2: Cluster -->
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Let the hosted backend drive this device for a hunt" android:textColor="@color/muted" android:textSize="12sp" android:paddingBottom="8dp" />
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <com.google.android.material.button.MaterialButton android:id="@+id/cluster" style="@style/Widget.Material3.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Connect to cluster" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/tailscaleBtn" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Set up Tailscale" />
                </LinearLayout>
                <TextView android:id="@+id/clusterStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                    android:text="Cluster: off" android:textColor="@color/muted" android:textSize="12sp" android:fontFamily="monospace" android:textIsSelectable="true" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Sign in to my-app.engineer (SSO) and pull your GB profiles" android:textColor="@color/muted" android:textSize="12sp" android:paddingBottom="8dp" />
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Cluster GB URL (ghost-browser.&lt;you&gt;.my-app.engineer)">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/clusterUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textUri" android:maxLines="1" android:textColor="@color/text" android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/signin" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Sign in (SSO)" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/fetchProfiles" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Fetch profiles" />
                </LinearLayout>
            </LinearLayout>
        </ViewFlipper>
        </ScrollView>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />
        <ScrollView android:id="@+id/logScroll" android:layout_width="match_parent" android:layout_height="140dp" android:padding="10dp" android:background="@color/bg">
            <TextView android:id="@+id/log" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/text" android:textSize="12sp" android:fontFamily="monospace" android:textIsSelectable="true" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>
