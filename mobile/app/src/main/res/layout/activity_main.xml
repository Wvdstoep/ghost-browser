<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- ============ MAIN ============ -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top bar (Chrome-like) -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bar"
            android:paddingHorizontal="6dp"
            android:paddingVertical="6dp"
            android:gravity="center_vertical">

            <ImageButton android:id="@+id/home"
                android:layout_width="42dp" android:layout_height="42dp"
                android:background="@drawable/bg_icon_ripple" android:padding="9dp"
                android:src="@drawable/ic_home" android:tint="@color/muted"
                android:contentDescription="Home" />

            <LinearLayout android:id="@+id/urlPill"
                android:orientation="horizontal"
                android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_url"
                android:gravity="center_vertical"
                android:paddingStart="12dp" android:paddingEnd="8dp">
                <ImageView android:layout_width="15dp" android:layout_height="15dp"
                    android:layout_marginEnd="8dp" android:src="@drawable/ic_globe" android:tint="@color/faint" />
                <EditText android:id="@+id/url"
                    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:inputType="textUri" android:imeOptions="actionGo" android:maxLines="1"
                    android:hint="Search or type a URL" android:textColor="@color/text"
                    android:textColorHint="@color/faint" android:textSize="14sp"
                    android:fontFamily="@font/manrope_medium" android:paddingVertical="0dp" />
            </LinearLayout>

            <ImageButton android:id="@+id/newTab"
                android:layout_width="42dp" android:layout_height="42dp"
                android:background="@drawable/bg_icon_ripple" android:padding="9dp"
                android:src="@drawable/ic_add" android:tint="@color/muted"
                android:contentDescription="New tab" />

            <TextView android:id="@+id/tabCount"
                android:layout_width="28dp" android:layout_height="28dp"
                android:layout_marginHorizontal="2dp"
                android:background="@drawable/bg_tabcount"
                android:gravity="center" android:text="1"
                android:textColor="@color/muted" android:textSize="12sp"
                android:fontFamily="@font/manrope_bold" />

            <ImageButton android:id="@+id/menuBtn"
                android:layout_width="42dp" android:layout_height="42dp"
                android:background="@drawable/bg_icon_ripple" android:padding="9dp"
                android:src="@drawable/ic_more" android:tint="@color/muted"
                android:contentDescription="Menu" />
        </LinearLayout>

        <FrameLayout android:id="@+id/webHolder"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

        <!-- Tools bottom sheet -->
        <LinearLayout
            android:id="@+id/panel"
            android:orientation="vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:visibility="gone" android:background="@drawable/bg_sheet"
            android:elevation="20dp" android:paddingTop="8dp">

            <View android:layout_width="42dp" android:layout_height="5dp"
                android:layout_gravity="center_horizontal" android:layout_marginBottom="6dp"
                android:background="@drawable/drag_handle" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabs"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:tabMode="fixed" app:tabGravity="fill"
                app:tabTextColor="@color/muted" app:tabSelectedTextColor="@color/text"
                app:tabIndicator="@drawable/tab_indicator" app:tabIndicatorColor="@color/accent"
                app:tabIndicatorFullWidth="false" app:tabTextAppearance="@style/Text.Tab"
                app:tabRippleColor="@color/accentDim">
                <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Agent" />
                <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Profiles" />
                <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cluster" />
            </com.google.android.material.tabs.TabLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/lineSoft" />

            <ScrollView
                android:id="@+id/toolsScroll"
                android:layout_width="match_parent" android:layout_height="410dp"
                android:fillViewport="true"
                android:scrollbars="none">
            <ViewFlipper
                android:id="@+id/flipper"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="16dp">

                <!-- 0: Agent -->
                <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView style="@style/Text.Eyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="On-device model" />
                    <TextView style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:paddingBottom="10dp" android:text="An offline agent that runs on the phone — no key, no network." />
                    <Spinner android:id="@+id/modelSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:popupBackground="@color/panel2" />
                    <TextView android:id="@+id/modelNote" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:paddingTop="4dp" android:paddingBottom="8dp" />
                    <com.google.android.material.textfield.TextInputLayout style="@style/Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Custom .task URL (for the Custom option)">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/customUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textUri" android:maxLines="1" android:textColor="@color/text" android:fontFamily="@font/manrope_regular" android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Access token (only if the model is gated)" app:endIconMode="password_toggle">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/hfToken" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:maxLines="1" android:textColor="@color/text" android:fontFamily="@font/manrope_regular" android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical">
                        <com.google.android.material.button.MaterialButton android:id="@+id/downloadModel" style="@style/Btn.Tonal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Download" app:icon="@drawable/ic_download" app:iconSize="18dp" />
                        <TextView android:id="@+id/modelStatus" style="@style/Text.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="not downloaded" />
                    </LinearLayout>
                    <ProgressBar android:id="@+id/modelProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:max="100" android:progress="0" android:visibility="gone" android:progressTint="@color/accent" />
                    <CheckBox android:id="@+id/useLocal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Use on-device model (instead of Ollama)" android:textColor="@color/text" android:fontFamily="@font/manrope_medium" android:textSize="13sp" android:buttonTint="@color/accent" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/lineSoft" android:layout_marginTop="14dp" android:layout_marginBottom="14dp" />

                    <TextView style="@style/Text.Eyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Or your Ollama key" />
                    <com.google.android.material.textfield.TextInputLayout style="@style/Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Ollama endpoint (https://host/v1)">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/endpoint" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textUri" android:maxLines="1" android:textColor="@color/text" android:fontFamily="@font/manrope_regular" android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="API key" app:endIconMode="password_toggle">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/apiKey" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:maxLines="1" android:textColor="@color/text" android:fontFamily="@font/manrope_regular" android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Model (e.g. glm-4)">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/model" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="@color/text" android:fontFamily="@font/manrope_regular" android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Task — what should GB do?">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/task" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text" android:fontFamily="@font/manrope_regular" android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                        <com.google.android.material.button.MaterialButton android:id="@+id/run" style="@style/Btn.Primary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Run" app:icon="@drawable/ic_play" app:iconSize="18dp" app:iconGravity="textStart" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/stop" style="@style/Btn.Outline" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Stop" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 1: Profiles -->
                <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView style="@style/Text.Eyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Your platforms" />
                    <TextView style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:paddingBottom="10dp" android:text="This phone is its own browser. Tap a platform to open it and sign in once — the session then lives in its own isolated profile on the device (real residential IP, passes bot walls)." />
                    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <com.google.android.material.button.MaterialButton android:id="@+id/loadPlatforms" style="@style/Btn.Tonal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Load from cluster" app:icon="@drawable/ic_link" app:iconSize="18dp" />
                        <TextView android:id="@+id/platformsHint" style="@style/Text.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Sign in on the Cluster tab first" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/platformCards" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/lineSoft" android:layout_marginTop="14dp" android:layout_marginBottom="14dp" />

                    <TextView style="@style/Text.Eyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Manual profiles" />
                    <TextView android:id="@+id/currentProfileLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Active: default" android:textColor="@color/accent" android:textSize="13sp" android:fontFamily="@font/manrope_bold" android:paddingBottom="6dp" />
                    <com.google.android.material.chip.ChipGroup android:id="@+id/profileChips" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" />
                    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical">
                        <com.google.android.material.textfield.TextInputLayout style="@style/Input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="New profile name">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/newProfile" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="@color/text" android:fontFamily="@font/manrope_regular" android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.button.MaterialButton android:id="@+id/addProfile" style="@style/Btn.Tonal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Add" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 2: Cluster -->
                <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView style="@style/Text.Eyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cluster" />
                    <TextView style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:paddingBottom="10dp" android:text="Let the hosted backend drive this device for a hunt." />
                    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <com.google.android.material.button.MaterialButton android:id="@+id/cluster" style="@style/Btn.Primary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Connect to cluster" app:icon="@drawable/ic_shield" app:iconSize="18dp" app:iconGravity="textStart" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/tailscaleBtn" style="@style/Btn.Outline" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Tailscale" />
                    </LinearLayout>
                    <TextView android:id="@+id/clusterStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Cluster: off" android:textColor="@color/muted" android:textSize="12sp" android:fontFamily="monospace" android:textIsSelectable="true" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/lineSoft" android:layout_marginTop="14dp" android:layout_marginBottom="14dp" />

                    <TextView style="@style/Text.Eyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sign in (SSO)" />
                    <TextView style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:paddingBottom="8dp" android:text="Sign in to my-app.engineer, open Ghost Browser from Tools, then pull your platforms." />
                    <com.google.android.material.textfield.TextInputLayout style="@style/Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Cluster GB URL">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/clusterUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textUri" android:maxLines="1" android:textColor="@color/text" android:fontFamily="@font/manrope_regular" android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                        <com.google.android.material.button.MaterialButton android:id="@+id/signin" style="@style/Btn.Tonal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Sign in" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/fetchProfiles" style="@style/Btn.Outline" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Fetch" />
                    </LinearLayout>
                </LinearLayout>
            </ViewFlipper>
            </ScrollView>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/lineSoft" />
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp" android:paddingTop="8dp" android:paddingBottom="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Activity" android:textColor="@color/faint" android:textSize="11sp" android:fontFamily="@font/manrope_bold" android:letterSpacing="0.08" android:textAllCaps="true" android:paddingBottom="6dp" />
                <ScrollView android:id="@+id/logScroll" android:layout_width="match_parent" android:layout_height="120dp" android:background="@drawable/bg_log" android:padding="10dp" android:scrollbars="none">
                    <TextView android:id="@+id/log" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="11sp" android:fontFamily="monospace" android:textIsSelectable="true" />
                </ScrollView>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ============ TAB SWITCHER OVERLAY ============ -->
    <LinearLayout android:id="@+id/tabSwitcher"
        android:orientation="vertical"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@color/bg" android:visibility="gone" android:elevation="24dp">
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/bar" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Tabs" style="@style/Text.Title" />
            <ImageButton android:id="@+id/newTabInSwitcher" android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/bg_icon_ripple" android:padding="9dp" android:src="@drawable/ic_add" android:tint="@color/accent" android:contentDescription="New tab" />
            <ImageButton android:id="@+id/closeSwitcher" android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/bg_icon_ripple" android:padding="9dp" android:src="@drawable/ic_close" android:tint="@color/muted" android:contentDescription="Close" />
        </LinearLayout>
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none">
            <LinearLayout android:id="@+id/tabList" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
