<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_search_button"
    android:contentDescription="Open Ghost Browser search"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <TextView
        android:layout_width="40dp" android:layout_height="40dp"
        android:background="@drawable/widget_brand_tile"
        android:contentDescription="Ghost Browser"
        android:gravity="center" android:text="G"
        android:textColor="#FFFFFF" android:textSize="21sp" android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="11dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1"
            android:text="Search the web" android:textColor="#F7F9FF"
            android:textSize="15sp" android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1"
            android:text="Ghost Browser" android:textColor="#B9C3D5" android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="40dp" android:layout_height="40dp"
        android:layout_marginStart="6dp" android:background="@drawable/widget_action_tile"
        android:contentDescription="Open search"
        android:padding="9dp" android:src="@drawable/ic_widget_search" />
</LinearLayout>
