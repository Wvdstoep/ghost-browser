<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_range_background"
    android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingVertical="13dp">

    <LinearLayout android:id="@+id/scan_widget_header"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:contentDescription="Open range scan setup">
        <TextView android:layout_width="34dp" android:layout_height="34dp"
            android:background="@drawable/widget_brand_tile" android:gravity="center"
            android:text="G" android:textSize="19sp" android:textStyle="bold" android:textColor="#FFFFFF" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="RANGE DISCOVERY" android:textColor="#AFCFFF" android:textSize="10sp"
                android:textStyle="bold" android:letterSpacing="0.11" />
            <TextView android:id="@+id/scan_widget_target"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:maxLines="1" android:text="No scan configured"
                android:textColor="#F7FAFF" android:textSize="16sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/scan_widget_status"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/widget_status_pill" android:paddingHorizontal="9dp"
            android:paddingVertical="6dp" android:text="READY" android:textColor="#DBEBFF"
            android:textSize="9sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/scan_widget_progress" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="0 / 1 hosts" android:textColor="#F5F8FF" android:textSize="13sp"
            android:textStyle="bold" />
        <TextView android:id="@+id/scan_widget_matches" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="0 MATCHES" android:textColor="#8FE6C9"
            android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>
    <ProgressBar android:id="@+id/scan_widget_bar" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="6dp"
        android:layout_marginTop="8dp" android:max="100" android:progress="0"
        android:progressTint="#7EBCFF" android:progressBackgroundTint="#32465F" />

    <TextView android:id="@+id/scan_widget_recent"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:background="@drawable/widget_range_result"
        android:contentDescription="Open range scan results" android:ellipsize="end" android:maxLines="1"
        android:paddingHorizontal="11dp" android:paddingVertical="9dp"
        android:text="Choose a range in Ghost Browser" android:textColor="#DAE8F8" android:textSize="12sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/scan_widget_start" android:layout_width="0dp"
            android:layout_height="40dp" android:layout_weight="1" android:background="@drawable/widget_range_primary"
            android:contentDescription="Start or resume scan" android:gravity="center" android:text="Set up"
            android:textColor="#071627" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/scan_widget_pause" android:layout_width="0dp"
            android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="6dp"
            android:background="@drawable/widget_range_control" android:contentDescription="Pause scan"
            android:gravity="center" android:text="Pause" android:textColor="#73859C"
            android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/scan_widget_stop" android:layout_width="0dp"
            android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="6dp"
            android:background="@drawable/widget_range_control" android:contentDescription="Stop scan"
            android:gravity="center" android:text="Stop" android:textColor="#73859C"
            android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/scan_widget_setup" android:layout_width="0dp"
            android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="6dp"
            android:background="@drawable/widget_range_control" android:contentDescription="Configure scan"
            android:gravity="center" android:text="Setup" android:textColor="#EAF3FF"
            android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
